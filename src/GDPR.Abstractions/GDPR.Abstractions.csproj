<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>GDPR.Abstractions</RootNamespace>
    <AssemblyName>GDPR.Abstractions</AssemblyName>
    <Version>1.0.0</Version>
    <PackageId>GDPR.Abstractions</PackageId>
    <Authors>mrdevrobot</Authors>
    <Description>GDPR Abstractions for .NET. Provides PersonalDataAttribute and SensitiveDataAttribute to mark properties and fields containing personal or sensitive data, enabling automated compliance scanning, data export, and anonymization tools.</Description>
    <PackageTags>GDPR;Abstractions;Attributes</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
